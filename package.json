{
  "name": "glassify",
  "version": "0.0.1",
  "private": true,
  "description": "A sleek and glassy spicetify theme created with @spicetify/creator",
  "type": "module",
  "scripts": {
    "sc": "spicetify-creator",
    "dev": "spicetify-creator dev",
    "build:theme": "spicetify-creator build",
    "build": "bun run docs:build && bun run build:theme",
    "update-types": "spicetify-creator update-types",
    "clean-spice": "spicetify-creator clean-spicetify --all",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.339",
    "esbuild": "^0.25.12",
    "esbuild-plugin-svgr": "^3.1.1",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-color-palette": "^7.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "three": "^0.179.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@spicemod/creator": "^0.0.36",
    "@types/bun": "^1.4.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.179.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.3",
    "vitepress": "^2.0.0-alpha.19",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
